<div class="tags-page">

  <!-- ========================================================= -->
  <!-- PAGE HEADER -->
  <!-- ========================================================= -->

  <div class="page-header">

    <div class="page-title">

      <span class="page-icon">
        🏷️
      </span>

      <h1>
        Thẻ bài viết
      </h1>

      <span class="total-badge">
        {{ tags.length }}
      </span>

    </div>


    <div class="page-actions">

      <!-- SEARCH -->

      <div class="search-bar">

        <svg
          width="13"
          height="13"
          viewBox="0 0 24 24"
          fill="none"
          stroke="#4a4540"
          stroke-width="2"
        >

          <circle
            cx="11"
            cy="11"
            r="8"
          />

          <path
            d="m21 21-4.35-4.35"
          />

        </svg>


        <input
          type="text"
          [value]="search"
          (input)="onSearchChange($any($event.target).value)"
          placeholder="Tìm thẻ..."
        />


        @if (search) {

          <button
            type="button"
            class="clear-search"
            (click)="clearSearch()"
          >

            <svg
              width="12"
              height="12"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >

              <path
                d="M18 6 6 18"
              />

              <path
                d="m6 6 12 12"
              />

            </svg>

          </button>

        }

      </div>


      <!-- ADD -->

      <button
        type="button"
        class="add-btn"
        (click)="openAdd()"
      >

        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
        >

          <path
            d="M12 5v14"
          />

          <path
            d="M5 12h14"
          />

        </svg>

        Tạo thẻ mới

      </button>

    </div>

  </div>


  <!-- ========================================================= -->
  <!-- TAG CLOUD -->
  <!-- ========================================================= -->

  <div class="tag-cloud">

    @for (
      tag of tags;
      track tag.tag_id
    ) {

      <span class="tag-cloud-item">

        # {{ tag.name }}

      </span>

    }

  </div>


  <!-- ========================================================= -->
  <!-- TABLE -->
  <!-- ========================================================= -->

  <div class="table-wrapper">

    <div class="table-scroll">

      <table>

        <thead>

          <tr>

            <th class="id-column">
              ID
            </th>

            <th>
              Tên thẻ
            </th>

            <th>
              Mô tả
            </th>

            <th class="action-column">
              Hành động
            </th>

          </tr>

        </thead>


        <tbody>

          @if (paged.length === 0) {

            <tr>

              <td
                colspan="4"
                class="empty-row"
              >
                Không có dữ liệu
              </td>

            </tr>

          } @else {

            @for (
              tag of paged;
              track tag.tag_id
            ) {

              <tr>

                <!-- ID -->

                <td>

                  <span class="tag-id">

                    #{{ tag.tag_id }}

                  </span>

                </td>


                <!-- NAME -->

                <td>

                  <span class="tag-name">

                    # {{ tag.name }}

                  </span>

                </td>


                <!-- DESCRIPTION -->

                <td>

                  <span class="description">

                    {{ tag.description || '—' }}

                  </span>

                </td>


                <!-- ACTION -->

                <td>

                  <div class="row-actions">

                    <!-- EDIT -->

                    <button
                      type="button"
                      class="action-btn edit-btn"
                      (click)="openEdit(tag)"
                    >

                      <svg
                        width="11"
                        height="11"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                      >

                        <path
                          d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"
                        />

                        <path
                          d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"
                        />

                      </svg>

                      Sửa

                    </button>


                    <!-- DELETE -->

                    <button
                      type="button"
                      class="action-btn delete-btn"
                      (click)="openDelete(tag)"
                    >

                      <svg
                        width="11"
                        height="11"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                      >

                        <polyline
                          points="3 6 5 6 21 6"
                        />

                        <path
                          d="m19 6-.867 14.142A2 2 0 0 1 16.138 22H7.862a2 2 0 0 1-1.995-1.858L5 6"
                        />

                        <path
                          d="M10 11v6"
                        />

                        <path
                          d="M14 11v6"
                        />

                        <path
                          d="M9 6V4h6v2"
                        />

                      </svg>

                      Xóa

                    </button>

                  </div>

                </td>

              </tr>

            }

          }

        </tbody>

      </table>

    </div>

  </div>


  <!-- ========================================================= -->
  <!-- PAGINATION -->
  <!-- ========================================================= -->

  @if (totalPages > 1) {

    <div class="pagination">

      <!-- RECORD INFO -->

      <span class="pagination-info">

        {{ recordStart }}–{{ recordEnd }}
        /
        {{ total }}
        bản ghi

      </span>


      <div class="pagination-controls">

        <!-- PREVIOUS -->

        <button
          type="button"
          class="pagination-btn"
          [disabled]="page === 1"
          (click)="changePage(page - 1)"
        >

          ←

        </button>


        <!-- PAGE NUMBERS -->

        <div class="pagination-pages">

          @for (
            item of paginationItems;
            track $index
          ) {

            @if (item === 'dots') {

              <span class="pagination-dots">

                ...

              </span>

            } @else {

              <button
                type="button"
                class="pagination-btn"
                [class.active]="item === page"
                (click)="changePage(item)"
              >

                {{ item }}

              </button>

            }

          }

        </div>


        <!-- NEXT -->

        <button
          type="button"
          class="pagination-btn"
          [disabled]="page === totalPages"
          (click)="changePage(page + 1)"
        >

          →

        </button>

      </div>

    </div>

  }


  <!-- ========================================================= -->
  <!-- ADD / EDIT MODAL -->
  <!-- ========================================================= -->

  @if (modal !== 'closed') {

    <div
      class="modal-overlay"
      (click)="closeModal()"
    >

      <div
        class="modal"
        (click)="$event.stopPropagation()"
      >

        <!-- HEADER -->

        <div class="modal-header">

          <h3>

            {{
              modal === 'add'
                ? 'Tạo thẻ mới'
                : 'Sửa thẻ'
            }}

          </h3>


          <button
            type="button"
            class="modal-close"
            (click)="closeModal()"
          >

            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >

              <path
                d="M18 6 6 18"
              />

              <path
                d="m6 6 12 12"
              />

            </svg>

          </button>

        </div>


        <!-- FORM -->

        <div class="modal-body">

          <div class="form-group">

            <label>
              Tên thẻ
              <span>*</span>
            </label>

            <input
              type="text"
              [(ngModel)]="form.name"
              placeholder="Nhập tên thẻ..."
            />

          </div>


          <div class="form-group">

            <label>
              Mô tả
            </label>

            <input
              type="text"
              [(ngModel)]="form.description"
              placeholder="Nhập mô tả..."
            />

          </div>

        </div>


        <!-- FOOTER -->

        <div class="modal-footer">

          <button
            type="button"
            class="cancel-btn"
            (click)="closeModal()"
          >

            Hủy

          </button>


          <button
            type="button"
            class="save-btn"
            [disabled]="!form.name.trim()"
            (click)="save()"
          >

            Lưu

          </button>

        </div>

      </div>

    </div>

  }


  <!-- ========================================================= -->
  <!-- DELETE DIALOG -->
  <!-- ========================================================= -->

  @if (deleteItem) {

    <div
      class="modal-overlay"
      (click)="closeDelete()"
    >

      <div
        class="delete-dialog"
        (click)="$event.stopPropagation()"
      >

        <div class="delete-title">

          <div class="warning-icon">

            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="#ef4444"
              stroke-width="2"
            >

              <path
                d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"
              />

              <path
                d="M12 9v4"
              />

              <path
                d="M12 17h.01"
              />

            </svg>

          </div>


          <h3>
            Xác nhận
          </h3>

        </div>


        <p>

          Xóa thẻ
          "<strong>#{{ deleteItem.name }}</strong>"?

        </p>


        <div class="delete-actions">

          <button
            type="button"
            class="cancel-btn"
            (click)="closeDelete()"
          >

            Hủy

          </button>


          <button
            type="button"
            class="confirm-delete-btn"
            (click)="confirmDelete()"
          >

            Xóa

          </button>

        </div>

      </div>

    </div>

  }

</div>

