import { CommonModule } from '@angular/common';
import { Component } from '@angular/core';
import { FormsModule } from '@angular/forms';

interface TagItem {
  tag_id: number;
  name: string;
  description: string;
}

@Component({
  selector: 'app-tag',
  standalone: true,
  imports: [CommonModule, FormsModule],
  templateUrl: './tag.html',
  styleUrl: './tag.css',
})
export class Tag {

  // ─────────────────────────────────────────────
  // CONFIG
  // ─────────────────────────────────────────────

  PER_PAGE = 10;

  page = 1;

  search = '';

  modal: 'closed' | 'add' | 'edit' = 'closed';

  deleteItem: TagItem | null = null;

  editItem: TagItem | null = null;

  form: {
    name: string;
    description: string;
  } = {
    name: '',
    description: ''
  };


  // ─────────────────────────────────────────────
  // DATA
  // ─────────────────────────────────────────────

  tags: TagItem[] = [
    {
      tag_id: 1,
      name: 'Technology',
      description: 'Công nghệ'
    },
    {
      tag_id: 2,
      name: 'Football',
      description: 'Bóng đá'
    },
    {
      tag_id: 3,
      name: 'Esports',
      description: 'Thể thao điện tử'
    },
    {
      tag_id: 4,
      name: 'Gaming',
      description: 'Game'
    },
    {
      tag_id: 5,
      name: 'News',
      description: 'Tin tức'
    },
    {
      tag_id: 6,
      name: 'Review',
      description: 'Đánh giá'
    },
    {
      tag_id: 7,
      name: 'Mobile',
      description: 'Điện thoại'
    },
    {
      tag_id: 8,
      name: 'PC',
      description: 'Máy tính'
    },
    {
      tag_id: 9,
      name: 'Entertainment',
      description: 'Giải trí'
    },
    {
      tag_id: 10,
      name: 'Movie',
      description: 'Phim ảnh'
    },
    {
      tag_id: 11,
      name: 'Music',
      description: 'Âm nhạc'
    },
    {
      tag_id: 12,
      name: 'Lifestyle',
      description: 'Phong cách sống'
    },
    {
      tag_id: 13,
      name: 'Business',
      description: 'Kinh doanh'
    },
    {
      tag_id: 14,
      name: 'Science',
      description: 'Khoa học'
    },
    {
      tag_id: 15,
      name: 'AI',
      description: 'Trí tuệ nhân tạo'
    }
  ];


  // ─────────────────────────────────────────────
  // SEARCH
  // ─────────────────────────────────────────────

  get filtered(): TagItem[] {

    const keyword =
      this.search
        .trim()
        .toLowerCase();

    if (!keyword) {
      return this.tags;
    }

    return this.tags.filter(tag =>
      tag.name
        .toLowerCase()
        .includes(keyword) ||

      tag.description
        .toLowerCase()
        .includes(keyword)
    );
  }


  // ─────────────────────────────────────────────
  // PAGINATION
  // ─────────────────────────────────────────────

  get paged(): TagItem[] {

    const start =
      (this.page - 1) *
      this.PER_PAGE;

    return this.filtered.slice(
      start,
      start + this.PER_PAGE
    );
  }


  get total(): number {

    return this.filtered.length;
  }


  get totalPages(): number {

    return Math.ceil(
      this.total /
      this.PER_PAGE
    );
  }


  get recordStart(): number {

    if (this.total === 0) {
      return 0;
    }

    return (
      (this.page - 1) *
      this.PER_PAGE
    ) + 1;
  }


  get recordEnd(): number {

    return Math.min(
      this.page *
      this.PER_PAGE,
      this.total
    );
  }


  get paginationItems():
    (number | 'dots')[] {

    const total =
      this.totalPages;

    const current =
      this.page;

    // Không có trang
    if (total === 0) {
      return [];
    }

    // Có ít trang
    if (total <= 6) {

      return Array.from(
        {
          length: total
        },
        (_, index) =>
          index + 1
      );
    }

    // Đầu danh sách
    if (current <= 3) {

      return [
        1,
        2,
        3,
        4,
        'dots',
        total - 1,
        total
      ];
    }

    // Cuối danh sách
    if (
      current >=
      total - 2
    ) {

      return [
        1,
        2,
        'dots',
        total - 3,
        total - 2,
        total - 1,
        total
      ];
    }

    // Ở giữa
    return [
      1,
      2,
      'dots',
      current - 1,
      current,
      'dots',
      total - 1,
      total
    ];
  }


  changePage(page: number): void {

    if (
      page < 1 ||
      page > this.totalPages
    ) {
      return;
    }

    this.page = page;
  }


  // ─────────────────────────────────────────────
  // SEARCH
  // ─────────────────────────────────────────────

  onSearchChange(value: string): void {

    this.search = value;

    // Search mới quay về trang 1
    this.page = 1;
  }


  clearSearch(): void {

    this.search = '';

    this.page = 1;
  }


  // ─────────────────────────────────────────────
  // ADD
  // ─────────────────────────────────────────────

  openAdd(): void {

    this.form = {
      name: '',
      description: ''
    };

    this.editItem = null;

    this.modal = 'add';
  }


  // ─────────────────────────────────────────────
  // EDIT
  // ─────────────────────────────────────────────

  openEdit(tag: TagItem): void {

    this.form = {
      name: tag.name,
      description: tag.description
    };

    this.editItem = tag;

    this.modal = 'edit';
  }


  // ─────────────────────────────────────────────
  // CLOSE MODAL
  // ─────────────────────────────────────────────

  closeModal(): void {

    this.modal = 'closed';

    this.editItem = null;

    this.form = {
      name: '',
      description: ''
    };
  }


  // ─────────────────────────────────────────────
  // SAVE
  // ─────────────────────────────────────────────

  save(): void {

    const name =
      this.form.name.trim();

    const description =
      this.form.description.trim();

    if (!name) {
      return;
    }


    // ADD
    if (this.modal === 'add') {

      const newId =
        this.tags.length > 0
          ? Math.max(
              ...this.tags.map(
                tag => tag.tag_id
              )
            ) + 1
          : 1;

      const newTag: TagItem = {
        tag_id: newId,
        name,
        description
      };

      this.tags = [
        newTag,
        ...this.tags
      ];
    }


    // EDIT
    if (
      this.modal === 'edit' &&
      this.editItem
    ) {

      const editId =
        this.editItem.tag_id;

      this.tags =
        this.tags.map(tag => {

          if (
            tag.tag_id === editId
          ) {

            return {
              ...tag,
              name,
              description
            };
          }

          return tag;
        });
    }

    this.closeModal();
  }


  // ─────────────────────────────────────────────
  // DELETE
  // ─────────────────────────────────────────────

  openDelete(tag: TagItem): void {

    this.deleteItem = tag;
  }


  closeDelete(): void {

    this.deleteItem = null;
  }


  confirmDelete(): void {

    if (!this.deleteItem) {
      return;
    }

    const id =
      this.deleteItem.tag_id;

    this.tags =
      this.tags.filter(
        tag => tag.tag_id !== id
      );

    this.deleteItem = null;

    // Nếu xóa bản ghi cuối cùng
    // của trang hiện tại thì lùi page
    if (
      this.page > this.totalPages &&
      this.totalPages > 0
    ) {

      this.page =
        this.totalPages;
    }

    // Không còn dữ liệu
    if (this.total === 0) {
      this.page = 1;
    }
  }
}
