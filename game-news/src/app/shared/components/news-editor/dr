<div class="news-editor">

  <!-- HEADER -->
  <header class="editor-header">

    <button
      class="back-button"
      (click)="closeEditor()">
      ←
      <span>Quay lại</span>
    </button>

   <div class="tabs-wrapper">

  <button
    type="button"
    class="tab-scroll-btn left"
    [class.hidden]="!hasScroll"
    (click)="scrollTabs('left')"
    aria-label="Cuộn sang trái"
  >
    <i class="fa-solid fa-chevron-left"></i>
  </button>

  <div
    #tabsContent
    class="tabs"
    (scroll)="onTabsScroll()"
  >

    <button
      [class.active]="tab === 'basic'"
      (click)="setTab('basic')">
      Cơ bản
    </button>

    <button
      [class.active]="tab === 'content'"
      (click)="setTab('content')">
      Nội dung

      @if (blocks.length) {
        <span class="badge">
          {{ blocks.length }}
        </span>
      }
    </button>

    <button
      [class.active]="tab === 'meta'"
      (click)="setTab('meta')">
      Thẻ & Đánh giá

      @if (selectedTags.length) {
        <span class="badge">
          {{ selectedTags.length }}
        </span>
      }
    </button>

    <button
      [class.active]="tab === 'other'"
      (click)="setTab('other')">
      Thông tin khác
    </button>

  </div>

  <button
    type="button"
    class="tab-scroll-btn right"
    [class.hidden]="!hasScroll"
    (click)="scrollTabs('right')"
    aria-label="Cuộn sang phải"
  >
    <i class="fa-solid fa-chevron-right"></i>
  </button>

</div>


    <div class="header-actions">

   <button
  type="button"
  class="preview-button"
  [class.active]="showPreview"
  (click)="showPreview = !showPreview"
>
  👁 Preview
</button>

@if (!news) {

  <!-- TẠO BÀI MỚI -->
  @if (currentUser.role === 'author') {

    <button
      type="button"
  
      (click)="handleAction('submit')">
      Gửi duyệt
    </button>

  } @else {

    <button
      type="button"
   
      (click)="handleAction('publish')">
      Đăng bài
    </button>

    <button
      type="button"
  
      (click)="handleAction('schedule')">
      Lên lịch
    </button>

  }

} @else {

<!-- SUBMMIT -->
 @if (news.status === 'draft') {

    @if (currentUser.role === 'author') {

      @if (!viewOnly) {

        <button
          type="button"
  
          (click)="handleAction('save')">
          Lưu bài
        </button>

      } @else {

        <button
          type="button"
       
          (click)="handleAction('edit')">
          Sửa bài
        </button>

      }

      <button
   
        (click)="handleAction('submit')">
        Gửi duyệt
      </button>

    }

  }
  <!-- DRAFT -->
  @if (news.status === 'submitted') {

    @if (currentUser.role === 'author') {

   

      <button
        type="button"
   
        (click)="handleAction('unsubmitted')">
        Hủy duyệt
      </button>

    }@else {
        <button
        type="button"
  
        (click)="handleAction('apply')">
       Aplly
      </button>
    }

  }


  <!-- PUBLISHED -->
  @if (news.status === 'published') {

    @if (currentUser.role === 'author') {

      <!-- Chỉ tác giả của bài mới được yêu cầu -->
      @if (news.author_id === currentUser.id) {

        <button
          type="button"
       
          (click)="handleAction('required')">
          Yêu cầu
        </button>

      }

    } @else {

      <button
        type="button"
    
        (click)="handleAction('unpublish')">
        Gỡ bài và xử lý
      </button>

    }

  }


  <!-- PROCESSING -->
@if (news.status === 'processing') {

  <!--
    NGƯỜI VIẾT BÀI:
    Nếu chính mình là tác giả thì được gửi yêu cầu
    kể cả khi mình là author, editor hay admin
  -->
  @if (news.author_id === currentUser.id) {

    <!-- Nếu mình đang trực tiếp xử lý bài -->
    @if (
      (currentUser.role === 'admin' ||
       currentUser.role === 'editor') &&
      news.reviewer_id === currentUser.id
    ) {

      @if (!viewOnly) {

        <button
          type="button"
     
          (click)="handleAction('save')">
          Lưu bài
        </button>

      } @else {

        <button
          type="button"

          (click)="handleAction('edit')">
          Sửa bài
        </button>

      }

      <button
        type="button"
    
        (click)="handleAction('return')">
        Trả về
      </button>

      <button
        type="button"
   
        (click)="handleAction('schedule')">
        Lên lịch
      </button>

      <button
        type="button"
       
        (click)="handleAction('publish')">
        Đăng bài
      </button>

    }

    <!--
      Mình là tác giả nhưng người khác đang xử lý
      => được gửi yêu cầu
    -->
    @else {

      <button
        type="button"
        
        (click)="handleAction('required')">
        Yêu cầu
      </button>

    }

  }

  <!--
    Không phải tác giả nhưng đang được giao xử lý
    => chỉ được xem/xử lý nếu reviewer_id là mình
  -->
  @else if (
    (currentUser.role === 'admin' ||
     currentUser.role === 'editor') &&
    news.reviewer_id === currentUser.id
  ) {

    @if (!viewOnly) {

      <button
        type="button"
       
        (click)="handleAction('save')">
        Lưu bài
      </button>

    } @else {

      <button
        type="button"
        
        (click)="handleAction('edit')">
        Sửa bài
      </button>

    }

    <button
      type="button"
      
      (click)="handleAction('return')">
      Trả về
    </button>

    <button
      type="button"
      
      (click)="handleAction('schedule')">
      Lên lịch
    </button>

    <button
      type="button"
      
      (click)="handleAction('publish')">
      Đăng bài
    </button>

  }

}



  <!-- RETURNED -->
  @if (news.status === 'returned') {

    @if (
      currentUser.role === 'author' &&
      news.author_id === currentUser.id
    ) {

      @if (!viewOnly) {

        <button
          type="button"
          
          (click)="handleAction('save')">
          Lưu bài
        </button>

      } @else {

        <button
          type="button"
          
          (click)="handleAction('edit')">
          Sửa bài
        </button>

      }

      <button
        type="button"
        
        (click)="handleAction('submit')">
        Gửi duyệt
      </button>

    }

  }


  <!-- SCHEDULED -->
  @if (news.status === 'scheduled') {

    @if (
      (currentUser.role === 'admin' ||
       currentUser.role === 'editor') &&
      news.reviewer_id === currentUser.id
    ) {

      <button
        type="button"
        
        (click)="handleAction('publish')">
        Đăng bài
      </button>

      <button
        type="button"
        
        (click)="handleAction('unschedule')">
        Hủy lịch
      </button>

    }

  }

}




    </div>

  </header>


  <!-- EDITOR NOTE -->
@if (news?.editor_note) {

  <div class="editor-note-banner">

    <span class="editor-note-icon">
      💬
    </span>

    <div class="editor-note-content">

      <p class="editor-note-title">
        Yêu cầu chỉnh sửa từ biên tập viên
      </p>

      <p class="editor-note-text">
        {{ news.editor_note }}
      </p>

    </div>

  </div>

}
@if (news?.requirement_note) {

  <div class="editor-note-banner">

    <span class="editor-note-icon">
      ⚠️
    </span>

    <div class="editor-note-content">

      <p class="editor-note-title">
        Yêu cầu chỉnh sửa
      </p>

      <p class="editor-note-text">
        {{ news.requirement_note }}
      </p>

    </div>

  </div>

}


  <!-- BODY -->
  <main class="editor-body">

    <!-- EDITOR -->
    <section
      class="editor-panel"
      [class.hidden]="(showPreview)">


  

      <!-- OTHER -->
      <!-- @if (tab === 'other') {

        <div class="tab-content">

          <h3>Thông tin khác</h3>

          <div class="field">

            <label>Game liên quan</label>

            <input
              [(ngModel)]="form.game_name"
              placeholder="Valorant, PUBG, LoL...">

          </div>

          <div class="field">

            <label>Nền tảng</label>

            <input
              [(ngModel)]="form.platform_name"
              placeholder="PC, PS5, Xbox, Mobile...">

          </div>

          <div class="field">

            <label>Tên nguồn</label>

            <input
              [(ngModel)]="form.source_name">

          </div>

          <div class="field">

            <label>URL nguồn</label>

            <input
              [(ngModel)]="form.source_url">

          </div>

          <div class="field">

            <label>SEO Slug</label>

            <input
              [(ngModel)]="form.slug">

          </div>

          <div class="field">

            <label>Mô tả SEO</label>

            <textarea
              [(ngModel)]="form.seo_description"
              rows="3">
            </textarea>

          </div>

        </div>

      } -->
   <fieldset [disabled]="viewOnly" class="editor-readonly">

    @if (tab === 'basic') {

        <div class="tab-content">

          <div class="field">

            <label>Tiêu đề *</label>

            <input
              [(ngModel)]="form.title"
              placeholder="Nhập tiêu đề bài viết...">

          </div>


          <!-- CATEGORY -->
       <div class="field">

  <label>Danh mục</label>

<div class="picker">

  @for (
    category of categories;
    track category.category_id
  ) {

    <button
      type="button"

      [class.selected]="
        form.category_id.includes(category.category_id)
      "

      (click)="
        toggleCategory(category.category_id)
      "
    >

      {{
        form.category_id.includes(category.category_id)
          ? '✓ '
          : ''
      }}

      {{ category.name }}

    </button>

  }

</div>


</div>



       



          <div class="field">

            <label>Thumbnail URL</label>

            <input
              [(ngModel)]="form.thumbnail"
              placeholder="https://...">

            @if (form.thumbnail) {

              <img
                [src]="form.thumbnail"
                class="thumbnail">

            }

          </div>

<!-- 
          <div class="field">

            <label>Ngày đăng</label>

            <input
              type="date"
              [(ngModel)]="form.published_at">

          </div> -->


          <!-- QUICK BLOCKS -->
          <div class="quick-blocks">

            <label>
              Thêm khối nội dung nhanh
            </label>

            <div class="block-buttons">

              <div class="toolbar">

                @for (type of blockTypes; track type) {

                  <button
                    type="button"
                    (click)="addBlock(type)">

                    <strong
                      [style.color]="
                        blockMeta[type].color
                      ">

                      {{ blockMeta[type].badge }}

                    </strong>

                    {{ blockMeta[type].label }}

                  </button>

                }

              </div>

            </div>

          </div>

        </div>

      }


      <!-- CONTENT -->
      @if (tab === 'content') {

        <div class="tab-content">

          <div class="toolbar">

            @for (type of blockTypes; track type) {

              <button
                type="button"
                (click)="addBlock(type)">

                + {{ blockMeta[type].label }}

              </button>

            }

          </div>


          @if (blocks.length === 0) {

            <div class="empty">
              Chưa có khối nội dung nào
            </div>

          }


          <div class="blocks">

            @for (
              block of blocks;
              track block.id;
              let i = $index
            ) {

              <div class="content-block">

                <div
                  class="block-type"
                  [style.color]="
                    blockMeta[block.type].color
                  ">

                  {{ blockMeta[block.type].badge }}

                </div>


                <div class="block-input">

                  @if (block.type === 'image') {

                    <input
                      [ngModel]="block.content"
                      (ngModelChange)="
                        updateBlock(block, $event)
                      "
                      [placeholder]="
                        blockMeta[block.type].placeholder
                      ">

                  } @else {

                    <textarea
                      [ngModel]="block.content"
                      (ngModelChange)="
                        updateBlock(block, $event)
                      "
                      [placeholder]="
                        blockMeta[block.type].placeholder
                      "
                      [rows]="
                        block.type === 'heading1' ||
                        block.type === 'heading2'
                          ? 1
                          : 3
                      ">
                    </textarea>

                  }


                  @if (
                    block.type === 'image' &&
                    block.content
                  ) {

                    <img
                      [src]="block.content"
                      class="block-image"
                      alt="">

                  }

                </div>


                <div class="block-controls">

                  <button
                    type="button"
                    [disabled]="i === 0"
                    (click)="moveBlock(i, -1)">
                    ↑
                  </button>

                  <button
                    type="button"
                    [disabled]="
                      i === blocks.length - 1
                    "
                    (click)="moveBlock(i, 1)">
                    ↓
                  </button>

                  <button
                    type="button"
                    class="delete"
                    (click)="deleteBlock(block.id)">
                    ×
                  </button>

                </div>

              </div>

            }

          </div>

        </div>

      }


      <!-- META -->
      @if (tab === 'meta') {

        <div class="tab-content">

          <h3>Thẻ bài viết</h3>

   <div class="tag-list">

  @for (tag of tags; track tag.tag_id) {

    <button
      type="button"
      class="tag-item"
      [class.selected]="selectedTags.includes(tag.tag_id)"
      (click)="toggleTag(tag.tag_id)"
      [title]="tag.description">

      @if (selectedTags.includes(tag.tag_id)) {
        <span class="tag-check">✓</span>
      }

      <span class="tag-name">
        #{{ tag.name }}
      </span>

    </button>

  }

</div>


          <div class="review">

            <h3>Đánh giá game</h3>

            @if (review) {

              <label>
                Điểm số:

                <strong>
                  {{ review.score }}/10
                </strong>
              </label>

              <input
                type="range"
                min="0"
                max="10"
                step="0.1"
                [(ngModel)]="review.score">

              <label>Điểm cộng</label>

              <textarea
                [(ngModel)]="review.pros">
              </textarea>

              <label>Điểm trừ</label>

              <textarea
                [(ngModel)]="review.cons">
              </textarea>

            } @else {

              <button
                type="button"
                class="add-button"
                (click)="
                  review = {
                    score: 7,
                    pros: '',
                    cons: ''
                  }
                ">

                + Thêm đánh giá

              </button>

            }

          </div>

        </div>

      }


   </fieldset>
    </section>


    <!-- PREVIEW -->
    @if (showPreview ) {

      <section class="preview-panel">

      <div class="preview-header">

  <span>● Preview</span>

  <div class="preview-header-info">

 

    <strong>
      {{ form.title || 'Bài viết mới' }}
    </strong>

    <span class="preview-author">

      @if (form.author_id === currentUser.id) {
        Bài viết của bạn
      } @else {
        Tác giả: {{ getUserName(form.author_id) }}
      }

    </span>

 @if (
  (form.status === 'scheduled' ||
   form.status === 'published') &&
  form.reviewer_id
) {

  <span class="preview-reviewer">

    Người kiểm duyệt:
    @if (form.reviewer_id === currentUser.id) {
      Bạn
    } @else {
      {{ getUserName(form.reviewer_id) }}
    }

  </span>

}


  </div>

</div>


   <div class="preview-content" >    
     <article class="preview">

        <div class="breadcrumb">
  Trang chủ /
  {{ form.category_id?.length
      ? getCategoryName(form.category_id[0])
      : 'Chưa có danh mục'
  }}
  /
  {{ form.title || 'Bài viết mới' }}
</div>


<div class="categories">

  @for (
    id of form.category_id;
    track id
  ) {

    <span class="category">

      {{
        categories.find(
          c => c.category_id === id
        )?.name
      }}

    </span>

  }

</div>



          <h1>
            {{ form.title || 'Tiêu đề bài viết...' }}
          </h1>


          <div class="author">

          <div class="avatar">
  {{ (getUserName(form.author_id) || 'A')[0] }}
</div>


            <div>

              <strong>
                {{ getUserName(form.author_id) }}
              </strong>

              <small>Tác giả</small>

            </div>

          </div>


          @if (form.thumbnail) {

            <img
              [src]="form.thumbnail"
              class="hero-image">

          }


          <div class="article-content">

            @for (block of blocks; track block.id) {

              @if (block.type === 'paragraph') {

                <p>
                  {{ block.content }}
                </p>

              }

              @if (block.type === 'heading1') {

                <h2>
                  {{ block.content }}
                </h2>

              }

              @if (block.type === 'heading2') {

                <h3>
                  {{ block.content }}
                </h3>

              }

              @if (
                block.type === 'image' &&
                block.content
              ) {

                <img
                  [src]="block.content"
                  alt="">

              }

              @if (block.type === 'quote') {

                <blockquote>
                  "{{ block.content }}"
                </blockquote>

              }

            }

          </div>

        </article></div>

      </section>

    }

  </main>
<!-- REQUIRED DIALOG -->
 @if (showRequirementDialog) {

  <div class="return-dialog-overlay">

    <div class="return-dialog">

      <div class="return-dialog-header">

        <h3>
          ⚠ Yêu cầu chỉnh sửa bài
        </h3>

        <button
          type="button"
          class="return-dialog-close"

        >
          ×
        </button>

      </div>

      <div class="return-dialog-body">

        <p class="article-title">
          {{ news?.title}}
        </p>

        <p class="article-author">
          Tác giả:
   {{ news ? getUserName(news.author_id) : 'Tác giả' }}

        </p>

        <label>
          Nội dung yêu cầu chỉnh sửa *
        </label>

        <textarea
          [(ngModel)]="requiredNote"
          placeholder="Mô tả cụ thể nội dung cần chỉnh sửa gì, bổ sung nội dung nào, lỗi gì cần sửa..."
          rows="5"
        ></textarea>

        <div class="return-dialog-actions">

          <button
            type="button"
            class="return-cancel"
         
          >
            Hủy
          </button>

          <button
            type="button"
            class="return-confirm"
            [disabled]="!requiredNote.trim()"
            (click)="confirmRequire()"
          >
            ⚠ Xác nhận yêu cầu
          </button>

        </div>

      </div>

    </div>

  </div>

}

  <!-- RETURN DIALOG -->
@if (showReturnDialog) {

  <div class="return-dialog-overlay">

    <div class="return-dialog">

      <div class="return-dialog-header">

        <h3>
          ↩ Trả bài cho tác giả
        </h3>

        <button
          type="button"
          class="return-dialog-close"
          (click)="showReturnDialog = false">

          ×

        </button>

      </div>


      <div class="return-dialog-body">

        <label>
          Ghi chú yêu cầu chỉnh sửa *
        </label>

        <textarea
          [(ngModel)]="editorNote"
          placeholder="Mô tả cụ thể cần chỉnh sửa gì, bổ sung nội dung nào, lỗi gì cần sửa..."
          rows="5">
        </textarea>


        <div class="return-dialog-actions">

          <button
            type="button"
            class="return-cancel"
            (click)="showReturnDialog = false">

            Huỷ

          </button>


          <button
            type="button"
            class="return-confirm"
            [disabled]="!editorNote.trim()"
            (click)="confirmReturn()">

            ↩ Xác nhận trả bài

          </button>

        </div>

      </div>

    </div>

  </div>

}
   @if (showScheduleDialog) {
    <div
    class="modal-overlay"
  >
    <div
      class="modal"
      (click)="$event.stopPropagation()"
    >



      <div class="modal-header">
        <h3>📅 Lên lịch đăng bài</h3>

        <button
          type="button"
          (click)="showScheduleDialog = false"
        >
          ×
        </button>
      </div>

      <div class="modal-body">

        <div class="article-preview">
          <small>BÀI VIẾT</small>

          <p>
        
          </p>
        </div>

        <label>
          Ngày đăng
        </label>

        <input
          type="date"
          [(ngModel)]="scheduleDate"
        >

        <label>
          Giờ đăng
        </label>

        <input
          type="time"
          [(ngModel)]="scheduleTime"
        >

    
          <div class="schedule-preview">
            📅 Sẽ đăng lúc
            {{ scheduleTime }}
            ngày
            {{ scheduleDate }}
          </div>
        

      </div>

      <div class="modal-footer">

        <button
          type="button"
          class="btn-secondary"
          (click)="showScheduleDialog = false"
        >
          Hủy
        </button>

        <button
          type="button"
          class="btn-primary"
          [disabled]="!scheduleDate"
             (click)="confirmSchedule()"
       
        >
          Xác nhận lên lịch
        </button>

      </div>

    </div>
  </div>
   }
  


</div>